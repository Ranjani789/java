package eventhandling;
import java.awt.*;
import java.awt.event.*;

public class eventhandling extends Frame implements ActionListener, TextListener {
    TextField t1, t2, t3;
    Label l4;

    eventhandling() {
        setTitle("STUDENT REGISTRATION");
        setSize(350, 300);
        setLayout(null);

        Label l1 = new Label("Roll No:");
        l1.setBounds(40, 40, 100, 30);
        add(l1);
        t1 = new TextField();
        t1.setBounds(150, 40, 150, 30);
        t1.setName("Roll No");
        t1.addTextListener(this);
        add(t1);

        Label l2 = new Label("Name:");
        l2.setBounds(40, 90, 100, 30);
        add(l2);
        t2 = new TextField();
        t2.setBounds(150, 90, 150, 30);
        t2.setName("Name");
        t2.addTextListener(this);
        add(t2);

        Label l3 = new Label("Course:");
        l3.setBounds(40, 140, 100, 30);
        add(l3);
        t3 = new TextField();
        t3.setBounds(150, 140, 150, 30);
        t3.setName("Course");
        t3.addTextListener(this);
        add(t3);

        Button b1 = new Button("REGISTER");
        b1.setBounds(80, 190, 100, 40);
        b1.addActionListener(this);
        add(b1);

        Button b2 = new Button("EXIT");
        b2.setBounds(190, 190, 100, 40);
        b2.addActionListener(this);
        add(b2);

        l4 = new Label();
        l4.setBounds(40, 240, 270, 30);
        add(l4);

        addWindowListener(new WindowAdapter() {
            public void windowClosing(WindowEvent e) {
                System.exit(0);
            }
        });

        setVisible(true);
    }

    public void actionPerformed(ActionEvent e) {
        if (e.getActionCommand().equals("REGISTER"))
            l4.setText("Registered: " + t1.getText() + " - " + t2.getText() + " - " + t3.getText());
        else
            System.exit(0);
    }

    public void textValueChanged(TextEvent e) {
        l4.setText("Typing in: " + ((TextField) e.getSource()).getName());
    }

    public static void main(String args[]) {
        new eventhandling();
    }
}
