java

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.Statement;
import java.sql.ResultSet;

public class Library {

    public static void main(String[] args) {

        String url = "jdbc:oracle:thin:@//localhost:1521/XEPDB1";
        String username = "SYSTEM";
        String password = "Oracle123";

        try {

            Class.forName("oracle.jdbc.driver.OracleDriver");

            Connection connection =DriverManager.getConnection(url, username, password);

            System.out.println("Connected to Oracle Database!");

            Statement statement = connection.createStatement();

            String student1 =
                    "INSERT INTO student (ID, NAME, COURSE, MARKS) " +
                    "VALUES (101, 'RANJANI', 'BCA', 92)";

            statement.executeUpdate(student1);

            System.out.println("First student inserted successfully!");

            String student2 =
                    "INSERT INTO student (ID, NAME, COURSE, MARKS) " +
                    "VALUES (102,'KANI', 'BSC CS', 85)";

            statement.executeUpdate(student2);

            System.out.println("Second student inserted successfully!");

            String display =
                    "SELECT * FROM student";

            ResultSet result =
                    statement.executeQuery(display);

            System.out.println();
            System.out.println("STUDENT DETAILS (BEFORE DELETE)");
            System.out.println("-------------------------");

            while (result.next()) {

                System.out.println(
                        "ID     : " +
                        result.getInt("ID"));

                System.out.println( "Name   : " + result.getString("NAME"));

                System.out.println( "Course : " + result.getString("COURSE"));

                System.out.println( "Marks  : " + result.getInt("MARKS"));

                System.out.println("-------------------------");
            }

            result.close();

            String deleteQuery = "DELETE FROM student WHERE ID = 102";
            statement.executeUpdate(deleteQuery);

            System.out.println();
            System.out.println("Student with ID 102 deleted successfully!");

            ResultSet updatedResult =
                    statement.executeQuery(display);

            System.out.println();
            System.out.println("STUDENT DETAILS (AFTER DELETE)");
            System.out.println("-------------------------");

            while (updatedResult.next()) {

                System.out.println("ID     : " + updatedResult.getInt("ID"));

                System.out.println("Name   : " +updatedResult.getString("NAME"));

                System.out.println("Course : " + updatedResult.getString("COURSE"));

                System.out.println("Marks  : " + updatedResult.getInt("MARKS"));

                System.out.println("-------------------------");
            }

            updatedResult.close();
            statement.close();
            connection.close();

            System.out.println("Connection closed!");

        } catch (Exception e) {

            e.printStackTrace();
        }
    }
}
